# =====================================================================
#  Prometis — variables d'environnement
#  Copier en `.env` puis adapter. `.env` n'est JAMAIS commité.
# =====================================================================

# --- Base de données -------------------------------------------------
# DEUX URLs, deux rôles PostgreSQL distincts. Ce n'est pas une redondance :
#   · DATABASE_URL        → rôle applicatif, SOUMIS à la Row-Level Security
#   · DIRECT_DATABASE_URL → rôle propriétaire, utilisé par prisma migrate/seed
# L'application ne doit jamais utiliser le rôle propriétaire.
DATABASE_URL="postgresql://prometis_app:prometis_app_dev@localhost:5432/prometis_dev?schema=public"
DIRECT_DATABASE_URL="postgresql://prometis:prometis_dev@localhost:5432/prometis_dev?schema=public"

# --- Redis (BullMQ : appels de fonds, exports, relances, webhooks) ---
REDIS_URL="redis://localhost:6379"

# --- API -------------------------------------------------------------
API_PORT=3001
NODE_ENV=development
# Origines autorisées pour le front (séparées par des virgules)
CORS_ORIGINS="http://localhost:3000"

# --- Web -------------------------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:3001"

# --- Passerelle Kolabimo ---------------------------------------------
# La clé Kolabimo n'est plus une variable d'environnement : chaque société la
# saisit dans l'écran Passerelle (voir plus bas, INTEGRATIONS_ENCRYPTION_KEY).

# --- Jetons (Lot 1) ---------------------------------------------------
# openssl rand -base64 48
JWT_SECRET="remplacer-par-48-octets-aleatoires-openssl-rand-base64-48"
JWT_EXPIRES_IN="8h"

# --- Messagerie -------------------------------------------------------
# TOUT e-mail sortant passe par MailService. Hors production, il est
# redirigé vers MAIL_REDIRECT_TO, avec le destinataire prévu en préfixe
# d'objet : « [→ acquereur@example.ch] Appel de fonds n° AF-2026-0001 ».
# Sans cette variable, l'envoi est REFUSÉ hors production — c'est ce qui
# empêche un appel de fonds de partir chez un vrai acquéreur.
MAIL_REDIRECT_TO="votre-adresse@example.ch"

# console = journalise sans rien envoyer (défaut, aucun identifiant requis)
# smtp    = envoie réellement, via les paramètres ci-dessous
MAIL_TRANSPORT="console"
MAIL_FROM="Prometis <noreply@prometis.ch>"

# SMTP Infomaniak, pour le domaine prometis.ch.
#   · SMTP_USER est l'adresse complète (noreply@prometis.ch), pas un login.
#   · Port 587 avec STARTTLS (SMTP_SECURE=false), ou 465 en TLS implicite
#     (SMTP_SECURE=true). Les deux fonctionnent ; 587 est l'usage courant.
#   · SMTP_PASSWORD ne se met JAMAIS dans ce fichier ni dans le dépôt :
#     il se dépose dans les variables d'environnement du serveur.
SMTP_HOST="mail.infomaniak.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="noreply@prometis.ch"
SMTP_PASSWORD=""

# Rappel du garde-fou : hors production, MAIL_REDIRECT_TO reste obligatoire.
# Passer MAIL_TRANSPORT=smtp sans elle fait REFUSER l'envoi — c'est ce qui
# empêche un appel de fonds de partir chez un vrai acquéreur depuis un poste
# de développement."

# --- Passerelle Kolabimo ----------------------------------------------
# Depuis Kolabimo 1.3.0 (SEC1), une clé d'API est cloisonnée à UN promoteur :
# chaque société Prometis saisit la sienne dans l'écran Passerelle, où elle est
# stockée chiffrée. La clé de chiffrement, elle, vit ici — hors de la base.
# Absente, l'enregistrement d'une connexion est refusé. openssl rand -base64 48
INTEGRATIONS_ENCRYPTION_KEY=""
# L'adresse à laquelle Kolabimo joint l'API Prometis pour ses webhooks. C'est
# elle qu'on affiche au promoteur. En production : l'origine publique de l'API.
PUBLIC_API_URL="http://localhost:3001"
KOLABIMO_TIMEOUT_MS=10000

# SENS ENTRANT (Kolabimo → Prometis) : rien à configurer ici. Chaque société
# a sa clé dans la table `api_keys` ; c'est elle qui identifie le tenant d'un
# webhook et qui signe son corps. Les clés du seed sont dans
# prisma/passerelle-cles-dev.ts — valeurs de développement, à régénérer.

# --- Stockage des documents (GED) -------------------------------------
# `local` écrit sous STOCKAGE_LOCAL_DIR — le défaut en développement, et
# REFUSÉ en production : le disque d'un conteneur n'est pas durable, la GED
# y perdrait ses pièces au premier redéploiement.
#
# `s3` vise l'object storage Infomaniak (compatible S3, données en Suisse).
# C'est le transport de production. La convention de clé est la même dans
# les deux cas : basculer ne change rien aux fiches en base.
STOCKAGE_TRANSPORT="local"
STOCKAGE_LOCAL_DIR="./var/documents"

# Object storage Infomaniak. L'adressage se fait par CHEMIN
# (endpoint/bucket/clé) : hors AWS, les sous-domaines par bucket supposent
# un certificat générique que le fournisseur n'a pas.
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY="

# --- Second facteur (MFA / TOTP) --------------------------------------
# Clé de chiffrement des secrets TOTP, qui vit HORS de la base : un secret
# TOTP ne peut pas être haché (il faut le relire pour vérifier un code),
# donc il est chiffré, et une copie du dump ne suffit plus à fabriquer les
# codes de quelqu'un.
#
# Absente, l'enrôlement est REFUSÉ plutôt que stocké en clair.
# En générer une : openssl rand -base64 48
MFA_ENCRYPTION_KEY=""
# Nom affiché dans l'application d'authentification du collaborateur.
MFA_ISSUER="Prometis"

# --- Extraction du texte des factures (OCR) ---------------------------
# AUTO-HÉBERGÉ, délibérément : une facture porte le nom d'un fournisseur,
# ses montants, parfois ses coordonnées bancaires. Déléguer l'étape à un
# service en ligne poserait une question nLPD à chaque pièce ; en appelant
# un binaire local, rien ne sort du serveur.
#
# absent = l'analyse fonctionne sur un texte fourni à la main (défaut).
# local  = appelle OCR_COMMANDE.
#
# `pdftotext` (paquet poppler-utils) suffit aux PDF déjà textuels, soit
# l'immense majorité des factures d'entreprise. Pour des scans, pointer sur
# `ocrmypdf` ou `tesseract`.
#
# La commande est lancée SANS shell : le nom de fichier ne peut pas être
# interprété comme une commande.
OCR_TRANSPORT="absent"
OCR_COMMANDE="pdftotext"
OCR_ARGUMENTS="-layout,{fichier},-"
OCR_TIMEOUT_MS=60000

# --- Sécurité : relais Next → API --------------------------------------
# Secret partagé par le relais Next et l'API. Le navigateur ne parle jamais à
# l'API : sans ce secret, elle voit tous les utilisateurs derrière l'adresse du
# serveur Next, et la limite de tentatives de connexion par adresse bloquerait
# tout le monde au premier attaquant. EXIGÉ en production (l'API refuse de
# démarrer sans). Même valeur dans les deux conteneurs. openssl rand -base64 48
RELAIS_SECRET=""

# --- IA : Infomaniak AI Services (Suisse) ------------------------------
# Seul fournisseur d'IA de Prometis — jamais OpenAI. Sert à proposer les
# équipements du passeport à partir des notices ; un humain valide chaque
# proposition. Absents, l'IA est éteinte et la saisie manuelle reste possible.
# Jeton : Manager → profil → Jetons API → « Application par défaut », scope
# « ai-tools – AI Services ». Product ID : ne s'affiche nulle part, se lit par
#   curl -H "Authorization: Bearer $TOKEN" "https://api.infomaniak.com/1/products?service_name=ai_tools"
INFOMANIAK_AI_TOKEN=""
INFOMANIAK_AI_PRODUCT_ID=""
# INFOMANIAK_AI_MODEL="Qwen/Qwen3.5-122B-A10B-FP8"

# --- Facturation Stripe par module (skill plans-payants) --------------
# Fermée par défaut. Ne l'ouvrir qu'en DERNIER : prix saisis dans l'espace
# exploitant, webhook branché et ses événements relus par l'API, passe
# quotidienne vérifiée sur une exécution réussie.
BILLING_DISABLED="true"
# Jamais dans le chat ni dans Git : uniquement dans le .env du serveur.
STRIPE_SECRET_KEY=""
# Webhook → https://<api>/webhooks/stripe, événements : checkout.session.completed,
# customer.subscription.created/updated/deleted/trial_will_end, invoice.paid,
# invoice.payment_failed.
STRIPE_WEBHOOK_SECRET=""
# Taux de TVA 8.1 % créé dans Stripe (txr_…) : les prix sont saisis HT.
STRIPE_TAX_RATE_ID=""
# Retour de Checkout et du portail.
PUBLIC_WEB_URL="http://localhost:3000"
# Passe quotidienne (avertissement J-3 de fin d'essai) : le cron du serveur
# appelle POST /internal/facturation/passe-quotidienne avec l'en-tête
# x-passe-secret. `openssl rand -base64 48`.
PASSE_QUOTIDIENNE_SECRET=""
