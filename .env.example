# =====================================================================
#  Prometis — variables d'environnement
#  Copier en `.env` puis adapter. `.env` n'est JAMAIS commité.
# =====================================================================

# --- Base de données -------------------------------------------------
# DEUX URLs, deux rôles PostgreSQL distincts. Ce n'est pas une redondance :
#   · DATABASE_URL        → rôle applicatif, SOUMIS à la Row-Level Security
#   · DIRECT_DATABASE_URL → rôle propriétaire, utilisé par prisma migrate/seed
# L'application ne doit jamais utiliser le rôle propriétaire.
DATABASE_URL="postgresql://prometis_app:prometis_app_dev@localhost:5432/prometis_dev?schema=public"
DIRECT_DATABASE_URL="postgresql://prometis:prometis_dev@localhost:5432/prometis_dev?schema=public"

# --- Redis (BullMQ : appels de fonds, exports, relances, webhooks) ---
REDIS_URL="redis://localhost:6379"

# --- API -------------------------------------------------------------
API_PORT=3001
NODE_ENV=development
# Origines autorisées pour le front (séparées par des virgules)
CORS_ORIGINS="http://localhost:3000"

# --- Web -------------------------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:3001"

# --- Passerelle Kolabimo (Lot 7) -------------------------------------
KOLABIMO_API_URL=""
KOLABIMO_API_KEY=""
# Secret partagé pour la signature HMAC-SHA256 des webhooks
KOLABIMO_WEBHOOK_SECRET=""

# --- Jetons (Lot 1) ---------------------------------------------------
# openssl rand -base64 48
JWT_SECRET="remplacer-par-48-octets-aleatoires-openssl-rand-base64-48"
JWT_EXPIRES_IN="8h"

# --- Messagerie -------------------------------------------------------
# TOUT e-mail sortant passe par MailService. Hors production, il est
# redirigé vers MAIL_REDIRECT_TO, avec le destinataire prévu en préfixe
# d'objet : « [→ acquereur@example.ch] Appel de fonds n° AF-2026-0001 ».
# Sans cette variable, l'envoi est REFUSÉ hors production — c'est ce qui
# empêche un appel de fonds de partir chez un vrai acquéreur.
MAIL_REDIRECT_TO="votre-adresse@example.ch"

# console = journalise sans rien envoyer (défaut, aucun identifiant requis)
# smtp    = envoie réellement, via les paramètres ci-dessous
MAIL_TRANSPORT="console"
MAIL_FROM="Prometis <ne-pas-repondre@prometis.ch>"

SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASSWORD=""

# --- Passerelle Kolabimo ----------------------------------------------
# SENS SORTANT (Prometis → Kolabimo). Laisser vide tant que le compte
# Kolabimo n'est pas ouvert : les événements sortants s'accumulent alors en
# boîte d'envoi, visibles dans l'écran Passerelle, et se rejouent d'un clic
# une fois ces deux variables renseignées. Rien ne casse entre-temps.
#
# La clé sert AUSSI de secret de signature HMAC des messages sortants.
KOLABIMO_API_URL=""
KOLABIMO_API_KEY=""
KOLABIMO_TIMEOUT_MS=10000

# SENS ENTRANT (Kolabimo → Prometis) : rien à configurer ici. Chaque société
# a sa clé dans la table `api_keys` ; c'est elle qui identifie le tenant d'un
# webhook et qui signe son corps. Les clés du seed sont dans
# prisma/passerelle-cles-dev.ts — valeurs de développement, à régénérer.

# --- Stockage des documents (GED) -------------------------------------
# `local` écrit sous STOCKAGE_LOCAL_DIR — le défaut, et le seul transport
# implémenté. Il permet de développer et tester la GED sans compte object
# storage, et il est REFUSÉ en production : le disque d'un conteneur n'est
# pas durable, la GED y perdrait ses pièces au premier redéploiement.
#
# `s3` est déclaré mais lève : choisir l'hébergeur (Exoscale, Infomaniak)
# engage la localisation des données au sens de la nLPD.
STOCKAGE_TRANSPORT="local"
STOCKAGE_LOCAL_DIR="./var/documents"
