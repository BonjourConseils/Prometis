// =====================================================================
//  SaaS de gestion de promotions immobilières — Modèle de données
//  Cible : Suisse romande · Multi-tenant · PostgreSQL + Prisma
//  Aligné sur les conventions Kolabimo (@map snake_case, @@map pluriel)
//  pour faciliter la passerelle entre les deux SaaS.
//
//  Multi-tenant : chaque table « métier » porte un `societeId`. L'isolation
//  est assurée en base par la Row-Level Security PostgreSQL (policy sur
//  societe_id = current_setting('app.societe_id')). Voir plan §7.2.
//
//  Convention monétaire : Decimal(12,2) en CHF. Pourcentages en Decimal.
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Rôle APPLICATIF (prometis_app) : soumis aux policies RLS.
  url       = env("DATABASE_URL")
  // Rôle PROPRIÉTAIRE (prometis) : utilisé par `prisma migrate` et le seed,
  // qui doivent créer les tables et poser les policies. L'application, elle,
  // ne se connecte jamais avec ce rôle.
  directUrl = env("DIRECT_DATABASE_URL")
}

// =====================================================================
//  1. TENANT — SOCIÉTÉ, UTILISATEURS, ACTIONNAIRES
// =====================================================================

enum UtilisateurRole {
  OWNER // propriétaire du compte (le promoteur)
  ADMIN
  CHEF_PROJET
  ECONOMISTE // économiste de la construction
  COMPTABILITE
  COMMERCIAL
  LECTURE_SEULE
  EXTERNE // notaire, banque, EG, architecte : accès restreint
}

/// Niveau d'accès accordé à un utilisateur SUR UNE OPÉRATION donnée
/// (aligné sur Kolabimo : READ_ONLY / OPERATE / MANAGE).
enum OperationAccessLevel {
  READ_ONLY // consultation
  OPERATE // saisie (ex. une EG/architecte qui saisit les soumissions)
  MANAGE // gestion complète de l'opération
}

/// Modules de l'app, pour restreindre finement un accès externe.
/// Vide = tous les modules permis par le niveau d'accès.
enum AccessModule {
  FONCIER
  BUDGET_CFC
  SOUMISSIONS
  CONTRATS
  FACTURES
  VENTES
  APPELS_FONDS
  DOCUMENTS
  SEANCES
  ACTEURS
  PASSEPORT
}

/// Profil de l'organisation cliente : détermine les modules activés par défaut.
enum SocieteProfil {
  PROMOTEUR
  ENTREPRISE_GENERALE
  ARCHITECTE
  BUREAU_TECHNIQUE
  REGIE
  AUTRE
}

/// Modules activables par société (édition). Un promoteur active tout ; une
/// entreprise générale ou un architecte n'active que la gestion de chantier.
enum AppModule {
  FONCIER
  BUDGET_CFC
  SOUMISSIONS
  ADJUDICATIONS
  CONTRATS
  FACTURES
  SUIVI_CHANTIER
  ECARTS
  SEANCES
  GED
  ACTEURS
  // Surcouche commercialisation (promoteur uniquement)
  LOTS
  ACQUEREURS
  BILAN_PROMOTEUR
  ECHEANCIER
  APPELS_FONDS
  TRESORERIE
  COURTAGE
  // Passeport numérique de l'ouvrage — il survit à la promotion
  PASSEPORT
}

/// Le tenant : l'organisation cliente (promoteur, EG, architecte…). Racine de l'isolation des données.
model Societe {
  id             Int           @id @default(autoincrement())
  raisonSociale  String        @map("raison_sociale")
  formeJuridique String?       @map("forme_juridique") // SA, Sàrl…
  ide            String?       @map("ide") // n° IDE (CHE-…)
  numeroTva      String?       @map("numero_tva")
  adresse        String?
  codePostal     String?       @map("code_postal")
  localite       String?
  canton         String? // VD, GE, VS…
  pays           String        @default("CH")
  email          String?
  telephone      String?
  logoUrl        String?       @map("logo_url")
  iban           String? // pour QR-factures émises
  profil         SocieteProfil @default(PROMOTEUR)
  /// Modules ouverts. **Dérivé** des souscriptions par `ModulesService.recalculer` —
  /// ne jamais l'écrire ailleurs, sinon un module s'active sans souscription.
  modulesActifs  AppModule[]   @map("modules_actifs")
  /// Modules résiliés : leurs données restent **lisibles**, plus modifiables.
  /// Résilier ne détruit rien.
  modulesLecture AppModule[]   @default([]) @map("modules_lecture")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  memberships        Membership[]
  actionnaires       Actionnaire[]
  operations         Operation[]
  acteurs            Acteur[]
  entreprises        Entreprise[]
  tauxAcquisition    TauxFraisAcquisition[]
  acquereurs         Acquereur[]
  factures           Facture[]
  documents          Document[]
  apiKeys            ApiKey[]
  connexionKolabimo  ConnexionKolabimo?
  souscriptions      SouscriptionModule[]
  historiqueModules  HistoriqueModule[]
  abonnement         AbonnementSociete?
  invitationsMembres InvitationMembre[]
  emailsEntrants     EmailEntrant[]
  emailsFacturation  EmailFacturation[]
  appelsIa           AppelIa[]
  auditLogs          AuditLog[]

  @@map("societes")
}

/// Identité de connexion (login). Une personne = un compte, qui peut être membre
/// de PLUSIEURS sociétés (espaces de travail) — ex. un collaborateur d'EG travaillant
/// pour deux promoteurs, avec un seul login et un sélecteur d'espace.
model Compte {
  id              Int       @id @default(autoincrement())
  email           String    @unique
  passwordHash    String    @map("password_hash")
  prenom          String?
  nom             String?
  isActive        Boolean   @default(true) @map("is_active")
  /// Opérateur de la plateforme (Digital Systems) : active les modules des
  /// sociétés. **Jamais** posé par l'API — uniquement en base, par l'exploitant.
  /// Ne donne aucun accès au contenu d'un client.
  adminPlateforme Boolean   @default(false) @map("admin_plateforme")
  lastLoginAt     DateTime? @map("last_login_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // --- Second facteur (TOTP, RFC 6238) — ajouté au Lot 9 -------------
  // Seule extension du modèle depuis sa validation, et elle a été arbitrée :
  // aucun champ n'existait pour un secret TOTP ni pour des codes de secours,
  // ce qui rendait le MFA littéralement impossible à livrer.
  //
  // `totpSecret` est CHIFFRÉ au repos (AES-256-GCM, clé hors base) et non
  // haché : vérifier un code suppose de le relire. `totpActiveAt` reste nul
  // tant que l'enrôlement n'a pas été confirmé par un premier code — sans
  // quoi un enrôlement interrompu enfermerait le compte dehors.
  totpSecret   String?   @map("totp_secret")
  totpActiveAt DateTime? @map("totp_active_at")
  /// Empreintes des codes de secours non encore consommés.
  codesSecours String[]  @map("codes_secours")

  memberships Membership[]

  @@map("comptes")
}

/// Appartenance d'un compte à une société (espace de travail), avec son rôle.
/// L'isolation reste par société : un compte n'accède à une société que via son
/// membership (et ses OperationAccess). Un membre externe (EG, architecte, notaire)
/// est rattaché à sa société-acteur.
model Membership {
  id        Int             @id @default(autoincrement())
  compteId  Int             @map("compte_id")
  societeId Int             @map("societe_id")
  role      UtilisateurRole @default(LECTURE_SEULE)
  fonction  String? // intitulé de poste (employé)
  acteurId  Int?            @map("acteur_id")
  isActive  Boolean         @default(true) @map("is_active")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  compte            Compte            @relation(fields: [compteId], references: [id], onDelete: Cascade)
  societe           Societe           @relation(fields: [societeId], references: [id], onDelete: Cascade)
  acteur            Acteur?           @relation(fields: [acteurId], references: [id])
  operationAccesses OperationAccess[]
  directionTravaux  Operation[]       @relation("DirectionTravaux")

  @@unique([compteId, societeId])
  @@index([societeId])
  // Sélecteur d'espace de travail : « à quelles sociétés ce compte
  // appartient-il ? ». Posé par la migration du Lot 1, déclaré ici pour que
  // le schéma et la base disent la même chose.
  @@index([compteId])
  @@map("memberships")
}

/// Actionnaires de la société (répartition du capital).
model Actionnaire {
  id        Int      @id @default(autoincrement())
  societeId Int      @map("societe_id")
  nom       String
  partPct   Decimal? @map("part_pct") @db.Decimal(5, 2) // % du capital
  fonction  String?
  createdAt DateTime @default(now()) @map("created_at")

  societe Societe @relation(fields: [societeId], references: [id], onDelete: Cascade)

  @@index([societeId])
  @@map("actionnaires")
}

/// Clé API par société pour la passerelle (Kolabimo, n8n, CRM…).
model ApiKey {
  id         Int       @id @default(autoincrement())
  societeId  Int       @map("societe_id")
  key        String    @unique
  label      String?
  isActive   Boolean   @default(true) @map("is_active")
  lastUsedAt DateTime? @map("last_used_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  societe Societe @relation(fields: [societeId], references: [id], onDelete: Cascade)

  @@map("api_keys")
}

/// Le raccordement d'une société Prometis à SON compte promoteur Kolabimo.
///
/// Deux sens, deux secrets, et aucun n'est le même :
///   · la **clé d'API** est générée par le promoteur dans Kolabimo (« Ma société
///     → Intégrations & API ») et saisie ici — Prometis s'en sert pour LIRE ;
///   · le **secret de webhook** est généré par Prometis et collé dans Kolabimo —
///     Kolabimo s'en sert pour SIGNER ce qu'il pousse, et nous pour le vérifier.
/// Les deux doivent être relus en clair : ils sont chiffrés (AES-256-GCM), la
/// clé de chiffrement vit hors de la base (`INTEGRATIONS_ENCRYPTION_KEY`).
///
/// Le **jeton** figure dans l'URL du webhook : Kolabimo n'envoie pas de clé
/// d'API avec ses webhooks, c'est donc l'URL qui dit à quelle société ils
/// s'adressent. Il n'est pas un secret — la signature l'est.
model ConnexionKolabimo {
  id                   Int       @id @default(autoincrement())
  societeId            Int       @unique @map("societe_id")
  baseUrl              String    @default("https://kolabimo.ch") @map("base_url")
  cleApiChiffree       String?   @map("cle_api_chiffree")
  /// Les derniers caractères de la clé, pour la reconnaître sans la montrer.
  cleApiApercu         String?   @map("cle_api_apercu")
  jetonWebhook         String    @unique @map("jeton_webhook")
  secretWebhookChiffre String    @map("secret_webhook_chiffre")
  /// Identité rendue par `GET /api/v1/me` au dernier test réussi.
  promoteurKolabimoId  Int?      @map("promoteur_kolabimo_id")
  promoteurKolabimoNom String?   @map("promoteur_kolabimo_nom")
  verifieeLe           DateTime? @map("verifiee_le")
  derniereErreur       String?   @map("derniere_erreur")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  societe Societe @relation(fields: [societeId], references: [id], onDelete: Cascade)

  @@map("connexions_kolabimo")
}

enum StatutSouscription {
  ESSAI
  ACTIF
  /// Résilié : les données restent lisibles, plus rien ne s'y écrit.
  RESILIE
}

/// La souscription d'une société à un **module commercial** — ce qui se vend :
/// appels de fonds, contrôle des factures, appels d'offres, passeport.
///
/// Un module commercial ouvre plusieurs modules techniques (`AppModule`) ; la
/// correspondance vit dans le code (`modules/catalogue.ts`), versionnée et testée,
/// pas en base où elle dériverait sans trace.
model SouscriptionModule {
  id                       Int                @id @default(autoincrement())
  societeId                Int                @map("societe_id")
  /// Code du module commercial : APPELS_DE_FONDS, CONTROLE_FACTURES…
  module                   String
  statut                   StatutSouscription
  depuis                   DateTime           @default(now())
  finEssai                 DateTime?          @map("fin_essai")
  resilieLe                DateTime?          @map("resilie_le")
  /// ADMIN (geste de l'exploitant), STRIPE, REPRISE (migration)
  source                   String
  /// L'élément d'abonnement Stripe qui la facture, le jour où elle l'est.
  stripeSubscriptionItemId String?            @map("stripe_subscription_item_id")
  /// Résiliation programmée : le module est payé jusqu'à cette date, puis
  /// passe en lecture seule. Calculé à la lecture, comme la fin d'un essai.
  finAcces                 DateTime?          @map("fin_acces")
  createdAt                DateTime           @default(now()) @map("created_at")
  updatedAt                DateTime           @updatedAt @map("updated_at")

  societe Societe @relation(fields: [societeId], references: [id], onDelete: Cascade)

  @@unique([societeId, module])
  @@map("souscriptions_modules")
}

/// Un e-mail reçu à l'adresse d'une promotion. Le message brut est gardé :
/// c'est la preuve de ce qui est arrivé, et ce qui permet de libérer une
/// quarantaine sans rien redemander à l'expéditeur.
model EmailEntrant {
  id               Int       @id @default(autoincrement())
  societeId        Int       @map("societe_id")
  operationId      Int       @map("operation_id")
  /// En-tête Message-ID : un message relu deux fois ne crée rien deux fois.
  messageId        String    @map("message_id")
  expediteur       String
  sujet            String?
  recuLe           DateTime  @map("recu_le")
  /// ACCEPTE, QUARANTAINE, REJETE
  statut           String
  motif            String?
  authentification String?
  brutCle          String?   @map("brut_cle")
  pieces           Int       @default(0)
  piecesAcceptees  Int       @default(0) @map("pieces_acceptees")
  traiteLe         DateTime? @map("traite_le")
  traiteParId      Int?      @map("traite_par_id")
  createdAt        DateTime  @default(now()) @map("created_at")

  societe   Societe   @relation(fields: [societeId], references: [id], onDelete: Cascade)
  operation Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  @@unique([societeId, messageId])
  @@index([operationId, createdAt])
  @@map("emails_entrants")
}

/// Invitation d'une personne à rejoindre la société : un employé, ou un
/// intervenant externe (architecte, direction des travaux…) avec ses accès
/// par opération. Le lien n'est stocké qu'en empreinte, vaut quatorze jours
/// et ne sert qu'une fois.
model InvitationMembre {
  id                 Int             @id @default(autoincrement())
  societeId          Int             @map("societe_id")
  email              String
  prenom             String?
  nom                String?
  role               UtilisateurRole
  fonction           String?
  /// Intervenant externe : le type et la société qu'il représente. Un
  /// acteur est créé (ou retrouvé) à l'acceptation.
  acteurType         ActeurType?     @map("acteur_type")
  societeNom         String?         @map("societe_nom")
  /// Accès accordés à l'acceptation : [{ operationId, accessLevel, modules }].
  acces              Json            @default("[]")
  /// Nommer cette personne direction des travaux de ces opérations.
  directionTravauxDe Int[]           @default([]) @map("direction_travaux_de")
  tokenHash          String          @unique @map("token_hash")
  expireLe           DateTime        @map("expire_le")
  accepteeLe         DateTime?       @map("acceptee_le")
  revoqueeLe         DateTime?       @map("revoquee_le")
  compteId           Int?            @map("compte_id")
  creeParId          Int?            @map("cree_par_id")
  createdAt          DateTime        @default(now()) @map("created_at")

  societe Societe @relation(fields: [societeId], references: [id], onDelete: Cascade)

  @@index([societeId, accepteeLe])
  @@map("invitations_membres")
}

/// Prix d'un module commercial. Catalogue de la PLATEFORME, commun à toutes
/// les sociétés : aucune donnée client. Saisi par l'exploitant ; la page des
/// modules, l'aperçu et Stripe lisent cette même ligne. Un module sans prix ou
/// sans identifiant Stripe ne se propose pas.
model TarifModule {
  id            Int      @id @default(autoincrement())
  module        String   @unique
  /// CHF hors taxes, par mois.
  prixMensuel   Decimal  @map("prix_mensuel") @db.Decimal(12, 2)
  stripePriceId String?  @map("stripe_price_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("tarifs_modules")
}

/// L'abonnement Stripe d'une société : UN seul, avec un élément par module.
/// Ajouter un module modifie cet abonnement ; en créer un second laisserait
/// le premier facturer, orphelin.
model AbonnementSociete {
  id                   Int       @id @default(autoincrement())
  societeId            Int       @unique @map("societe_id")
  stripeCustomerId     String    @unique @map("stripe_customer_id")
  stripeSubscriptionId String?   @unique @map("stripe_subscription_id")
  /// Statut Stripe tel quel : trialing, active, past_due, canceled…
  statut               String?
  finPeriode           DateTime? @map("fin_periode")
  annulationFinPeriode Boolean   @default(false) @map("annulation_fin_periode")
  /// Fin de l'essai. Conservée après résiliation : c'est elle qui refuse un
  /// second essai, pas Stripe. Recopiée à chaque synchronisation quand Stripe
  /// annonce une date — jamais effacée.
  essaiFinLe           DateTime? @map("essai_fin_le")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  societe Societe @relation(fields: [societeId], references: [id], onDelete: Cascade)

  @@map("abonnements_societes")
}

/// Les événements Stripe reçus : dédoublonnage (Stripe livre parfois deux
/// fois) et trace. Écrits avant de savoir à quelle société ils appartiennent.
model EvenementStripe {
  id        String    @id
  type      String
  societeId Int?      @map("societe_id")
  recuLe    DateTime  @default(now()) @map("recu_le")
  traiteLe  DateTime? @map("traite_le")
  erreur    String?

  @@map("evenements_stripe")
}

/// Un e-mail de facturation ne part qu'une fois par événement : la clé
/// (« fin-essai ») et la référence (la date de fin) le rendent unique.
model EmailFacturation {
  id        Int      @id @default(autoincrement())
  societeId Int      @map("societe_id")
  cle       String
  reference String
  envoyeLe  DateTime @default(now()) @map("envoye_le")

  societe Societe @relation(fields: [societeId], references: [id], onDelete: Cascade)

  @@unique([societeId, cle, reference])
  @@map("emails_facturation")
}

/// Chaque exécution de la passe quotidienne. Sans trace, « est-ce que ça
/// tourne ? » n'a pas de réponse.
model PasseQuotidienne {
  id      Int       @id @default(autoincrement())
  debut   DateTime  @default(now())
  fin     DateTime?
  envoyes Int       @default(0)
  erreur  String?

  @@map("passes_quotidiennes")
}

/// Chaque changement d'état d'un module, avec qui, pourquoi, et combien.
/// « Appels de fonds actif depuis le 18.09.2026 » se lit ici.
model HistoriqueModule {
  id              Int                 @id @default(autoincrement())
  societeId       Int                 @map("societe_id")
  module          String
  de              StatutSouscription?
  vers            StatutSouscription
  source          String
  /// Obligatoire pour un geste de l'exploitant : un accès ouvert à la main
  /// sans raison écrite ne se justifie plus six mois plus tard.
  raison          String?
  /// Compte de l'exploitant — pas un membership : il n'appartient pas à la société.
  parCompteId     Int?                @map("par_compte_id")
  montantCentimes Int?                @map("montant_centimes")
  createdAt       DateTime            @default(now()) @map("created_at")

  societe Societe @relation(fields: [societeId], references: [id], onDelete: Cascade)

  @@index([societeId, createdAt])
  @@map("historique_modules")
}

enum EquipementCategorie {
  CHAUFFAGE
  VENTILATION
  SANITAIRE
  ELECTRICITE
  PHOTOVOLTAIQUE
  ASCENSEUR
  CUISINE
  MENUISERIE
  TOITURE
  FACADE
  SECURITE
  AMENAGEMENTS_EXTERIEURS
  AUTRE
}

enum EquipementStatut {
  /// Proposé — par l'IA à partir d'une notice, ou importé. N'existe pas dans
  /// le passeport tant qu'un humain ne l'a pas validé.
  PROPOSE
  VALIDE
}

/// Un équipement de l'ouvrage livré : ce qu'il faut savoir dix ans plus tard
/// — qui l'a posé, sa garantie, son entretien, sa notice.
///
/// `lotId` nul = parties communes. Rattaché au contrat de l'entreprise qui
/// l'a posé quand on le sait : c'est de là que vient la garantie SIA 118.
model Equipement {
  id                       Int                 @id @default(autoincrement())
  operationId              Int                 @map("operation_id")
  bienId                   Int?                @map("bien_id")
  lotId                    Int?                @map("lot_id")
  categorie                EquipementCategorie
  designation              String
  marque                   String?
  modele                   String?
  numeroSerie              String?             @map("numero_serie")
  emplacement              String?
  entrepriseId             Int?                @map("entreprise_id")
  contratId                Int?                @map("contrat_id")
  cfcNodeId                Int?                @map("cfc_node_id")
  dateMiseEnService        DateTime?           @map("date_mise_en_service")
  garantieFabricantFin     DateTime?           @map("garantie_fabricant_fin")
  entretienPeriodiciteMois Int?                @map("entretien_periodicite_mois")
  dernierEntretien         DateTime?           @map("dernier_entretien")
  notes                    String?
  statut                   EquipementStatut    @default(VALIDE)
  /// Pour une proposition : le document dont elle vient, et l'extrait qui la
  /// justifie — une valeur proposée cite toujours sa source.
  sourceDocumentId         Int?                @map("source_document_id")
  sourceExtrait            String?             @map("source_extrait")
  valideLe                 DateTime?           @map("valide_le")
  /// Membership qui a validé.
  valideParId              Int?                @map("valide_par_id")
  createdAt                DateTime            @default(now()) @map("created_at")
  updatedAt                DateTime            @updatedAt @map("updated_at")

  operation      Operation   @relation(fields: [operationId], references: [id], onDelete: Cascade)
  bien           Bien?       @relation(fields: [bienId], references: [id], onDelete: SetNull)
  lot            Lot?        @relation(fields: [lotId], references: [id], onDelete: SetNull)
  entreprise     Entreprise? @relation(fields: [entrepriseId], references: [id], onDelete: SetNull)
  contrat        Contrat?    @relation(fields: [contratId], references: [id], onDelete: SetNull)
  cfcNode        CfcNode?    @relation(fields: [cfcNodeId], references: [id], onDelete: SetNull)
  sourceDocument Document?   @relation("PropositionSource", fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  documents      Document[]  @relation("DocumentEquipement")

  @@index([operationId])
  @@map("equipements")
}

/// Chaque appel à l'IA : pour quoi, quel modèle **réellement envoyé**, combien.
/// Sans ce journal, le coût d'un fournisseur ne se lit nulle part.
model AppelIa {
  id            Int      @id @default(autoincrement())
  societeId     Int      @map("societe_id")
  /// « passeport.equipements »…
  usage         String
  modele        String
  tokensEntree  Int?     @map("tokens_entree")
  tokensSortie  Int?     @map("tokens_sortie")
  /// Estimé depuis la table de prix, en millièmes de franc.
  coutMilliemes Int?     @map("cout_milliemes")
  dureeMs       Int      @map("duree_ms")
  succes        Boolean
  erreur        String?
  createdAt     DateTime @default(now()) @map("created_at")

  societe Societe @relation(fields: [societeId], references: [id], onDelete: Cascade)

  @@index([societeId, createdAt])
  @@map("appels_ia")
}

// =====================================================================
//  2. OPÉRATION, FONCIER, BIENS, LOTS, PARKINGS
// =====================================================================

enum OperationStatut {
  MONTAGE
  EN_PREPARATION
  EN_CHANTIER
  EN_COMMERCIALISATION
  LIVRAISON
  CLOTUREE
}

enum BienNature {
  LOTISSEMENT
  VILLA
  IMMEUBLE
  CHALET
}

enum LotStatut {
  DISPONIBLE
  RESERVE
  EN_ATTENTE_NOTAIRE
  VENDU
}

/// Types de parc — ALIGNÉ sur Kolabimo (ParkingType).
enum ParkingType {
  EXTERIEURE
  INTERIEURE
  COUVERTE
  BOX
  AUTRE
}

/// Type d'acteur intervenant sur la promotion — aligné sur Kolabimo (ActeurProjetType),
/// enrichi (ingénieur / pilote). Ce sont des sociétés (bureaux, études, EG…).
enum ActeurType {
  NOTAIRE
  GEOMETRE
  INGENIEUR
  ARCHITECTE
  BUREAU_TECHNIQUE
  ENTREPRISE_GENERALE
  COURTIER
  MAITRE_OUVRAGE
  PILOTE
  /// Direction des travaux : nommée sur une opération, elle mène le
  /// contrôle des factures (visa avant l'approbation du promoteur).
  DIRECTION_TRAVAUX
  AUTRE
}

/// Mode de réalisation de l'opération : qui « se charge de tout ».
enum ModeRealisation {
  ENTREPRISE_GENERALE // une EG pilote l'ensemble
  MANDAT_ARCHITECTE // l'architecte mandataire pilote l'ensemble
  CORPS_DETAT_SEPARES // le promoteur adjuge lot par lot
}

/// La promotion / le projet. Mappé à une promotion Kolabimo via kolabimoPromotionId.
model Operation {
  id                   Int             @id @default(autoincrement())
  societeId            Int             @map("societe_id")
  nom                  String
  description          String?
  commune              String?
  canton               String?
  parcelle             String?
  statut               OperationStatut @default(MONTAGE)
  dateDebut            DateTime?       @map("date_debut")
  dateLivraisonPrevue  DateTime?       @map("date_livraison_prevue")
  /// La direction des travaux de l'opération (un membre). Nommée, elle vise
  /// chaque facture avant l'approbation du promoteur.
  directionTravauxId   Int?            @map("direction_travaux_id")
  directionTravaux     Membership?     @relation("DirectionTravaux", fields: [directionTravauxId], references: [id], onDelete: SetNull)
  /// Adresse de réception des factures : `<nom>-<jeton>@<domaine>`. Le jeton
  /// aléatoire la rend impossible à deviner ; le renouveler ferme l'ancienne.
  boiteFacturesJeton   String?         @unique @map("boite_factures_jeton")
  /// Accepter tout expéditeur. Faux par défaut : seuls les expéditeurs connus
  /// de la promotion passent, les autres vont en quarantaine.
  boiteFacturesOuverte Boolean         @default(false) @map("boite_factures_ouverte")
  emailsEntrants       EmailEntrant[]

  /// Recettes attendues, saisies AVANT le plan de vente.
  ///
  /// À l'étude de faisabilité, les lots n'existent pas encore : le promoteur
  /// raisonne sur un total de ventes estimé. Dès qu'un lot est saisi, ce sont
  /// les prix réels qui priment — ce champ ne sert plus que de repère.
  recettesPrevisionnelles Decimal? @map("recettes_previsionnelles") @db.Decimal(12, 2)

  // Foncier (CFC 0) — synthèse ; le détail chiffré vit dans les lignes de budget.
  prixTerrain         Decimal? @map("prix_terrain") @db.Decimal(12, 2)
  fraisNotaireTerrain Decimal? @map("frais_notaire_terrain") @db.Decimal(12, 2)
  droitsMutation      Decimal? @map("droits_mutation") @db.Decimal(12, 2)
  terrainAvecBatiment Boolean  @default(false) @map("terrain_avec_batiment")

  // Mode de réalisation : EG « clé en main », mandat d'architecte, ou corps d'état séparés.
  modeRealisation         ModeRealisation? @map("mode_realisation")
  // Notaire de la promotion (surchargé par lot au besoin, cf. Reservation.notaireActeurId).
  notaireActeurId         Int?             @map("notaire_acteur_id")
  // Maître d'ouvrage (le promoteur) comme CONTACT — utile quand l'opération est
  // possédée dans l'app par une EG ou un architecte (promoteur absent de l'app).
  maitreOuvrageActeurId   Int?             @map("maitre_ouvrage_acteur_id")
  // Surcouche commercialisation (lots, acquéreurs, appels de fonds) active ?
  // Faux pour un chantier piloté par une EG / un architecte sans promoteur.
  commercialisationActive Boolean          @default(true) @map("commercialisation_active")

  // Passerelle Kolabimo
  kolabimoPromotionId Int? @map("kolabimo_promotion_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  societe             Societe           @relation(fields: [societeId], references: [id], onDelete: Cascade)
  notaireActeur       Acteur?           @relation("OperationNotaire", fields: [notaireActeurId], references: [id])
  maitreOuvrageActeur Acteur?           @relation("OperationMaitreOuvrage", fields: [maitreOuvrageActeurId], references: [id])
  biens               Bien[]
  operationActeurs    OperationActeur[]
  cfcNodes            CfcNode[]
  budgetVersions      BudgetVersion[]
  soumissions         Soumission[]
  contrats            Contrat[]
  factures            Facture[]
  reservations        Reservation[]
  echeancierEtapes    EcheancierEtape[]
  documents           Document[]
  seances             Seance[]
  parcelles           Parcelle[]
  ppes                Ppe[]
  mandatsCourtage     MandatCourtage[]
  operationAccesses   OperationAccess[]

  equipements Equipement[]

  @@index([societeId])
  @@index([kolabimoPromotionId])
  @@map("operations")
}

/// Annuaire des acteurs (sociétés) réutilisables sur plusieurs opérations :
/// notaires, géomètres, ingénieurs, architectes, entreprises générales, etc.
/// Équivalent de l'`Acteur` de Kolabimo.
model Acteur {
  id         Int        @id @default(autoincrement())
  societeId  Int        @map("societe_id")
  type       ActeurType @default(NOTAIRE)
  typeLibre  String?    @map("type_libre")
  societeNom String?    @map("societe_nom") // raison sociale de l'acteur
  nom        String?
  prenom     String?
  adresse    String?
  codePostal String?    @map("code_postal")
  localite   String?
  email      String?
  telephone  String?
  ide        String?
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  societe                 Societe           @relation(fields: [societeId], references: [id], onDelete: Cascade)
  operationActeurs        OperationActeur[]
  operationsNotaire       Operation[]       @relation("OperationNotaire")
  operationsMaitreOuvrage Operation[]       @relation("OperationMaitreOuvrage")
  reservationsNotaire     Reservation[]     @relation("ReservationNotaire")
  documents               Document[]
  mandatsCourtage         MandatCourtage[]  @relation("CourtierMandat")
  memberships             Membership[]

  @@index([societeId, type])
  @@map("acteurs")
}

/// Rattachement d'un acteur à une opération, avec son rôle sur le projet.
/// `estMandataireGeneral` = l'EG ou l'architecte qui « se charge de tout ».
/// `suitLeProjet` = acteur retenu/actif (vs simplement consulté).
model OperationActeur {
  id                   Int        @id @default(autoincrement())
  operationId          Int        @map("operation_id")
  acteurId             Int        @map("acteur_id")
  role                 ActeurType
  roleLibre            String?    @map("role_libre")
  estMandataireGeneral Boolean    @default(false) @map("est_mandataire_general")
  suitLeProjet         Boolean    @default(true) @map("suit_le_projet")
  // Montant contractuel/honoraires de l'acteur (mandat), s'il y a lieu.
  montantMandat        Decimal?   @map("montant_mandat") @db.Decimal(12, 2)
  ordre                Int        @default(0)
  createdAt            DateTime   @default(now()) @map("created_at")

  operation Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  acteur    Acteur    @relation(fields: [acteurId], references: [id])

  @@unique([operationId, acteurId, role])
  @@index([operationId])
  @@map("operation_acteurs")
}

/// Un bien de l'opération : lotissement, villa, immeuble ou chalet.
model Bien {
  id          Int        @id @default(autoincrement())
  operationId Int        @map("operation_id")
  nature      BienNature @default(IMMEUBLE)
  nom         String
  nbEtages    Int?       @map("nb_etages")
  description String?
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  operation Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  lots      Lot[]

  equipements Equipement[]

  @@index([operationId])
  @@map("biens")
}

/// Unité vendable (appartement PPE, villa, chalet). Mappé à un appartement Kolabimo.
model Lot {
  id           Int       @id @default(autoincrement())
  bienId       Int       @map("bien_id")
  reference    String
  etage        Int?
  nombrePieces Decimal?  @map("nombre_pieces") @db.Decimal(3, 1)
  surfaceM2    Decimal?  @map("surface_m2") @db.Decimal(7, 2)
  quotePartPPE Decimal?  @map("quote_part_ppe") @db.Decimal(6, 3) // millièmes PPE
  prixVente    Decimal?  @map("prix_vente") @db.Decimal(12, 2)
  statut       LotStatut @default(DISPONIBLE)

  // Passerelle Kolabimo
  kolabimoAppartementId Int? @map("kolabimo_appartement_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  bien               Bien                @relation(fields: [bienId], references: [id], onDelete: Cascade)
  parkings           Parking[]
  reservations       Reservation[]
  documents          Document[]
  mandatCourtageLots MandatCourtageLot[]

  equipements Equipement[]

  @@index([bienId])
  @@index([kolabimoAppartementId])
  @@map("lots")
}

/// Place de parc rattachée à un lot. Entre dans le prix total acte du lot
/// (prix total acte = prixVente du lot + Σ prix des parkings).
model Parking {
  id                Int         @id @default(autoincrement())
  lotId             Int         @map("lot_id")
  reference         String?
  type              ParkingType @default(EXTERIEURE)
  prix              Decimal?    @db.Decimal(12, 2)
  ordre             Int         @default(0)
  kolabimoParkingId Int?        @map("kolabimo_parking_id")
  createdAt         DateTime    @default(now()) @map("created_at")

  lot Lot @relation(fields: [lotId], references: [id], onDelete: Cascade)

  @@index([lotId])
  @@map("parkings")
}

// =====================================================================
//  3. CFC & BUDGET
// =====================================================================

/// Nœud de l'arborescence CFC de l'opération (arbre à N niveaux, adjacency list).
/// Ex. 2 → 27 → 271 → 271.0. Agrège budgété / adjugé / commandé / facturé.
model CfcNode {
  id            Int      @id @default(autoincrement())
  operationId   Int      @map("operation_id")
  parentId      Int?     @map("parent_id")
  code          String // "2", "27", "271", "271.0"
  libelle       String
  niveau        Int // profondeur (1 = groupe principal)
  ordre         Int      @default(0)
  /// Posé par l'import de la trame de départ. Un poste créé à la main par le
  /// promoteur reste à `false` : c'est ce qui permet de replier la trame sans
  /// jamais masquer ce qu'il a ajouté lui-même.
  issuDeLaTrame Boolean  @default(false) @map("issu_de_la_trame")
  createdAt     DateTime @default(now()) @map("created_at")

  operation Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  parent    CfcNode?  @relation("CfcHierarchie", fields: [parentId], references: [id])
  enfants   CfcNode[] @relation("CfcHierarchie")

  lignesBudget LigneBudget[]
  soumissions  Soumission[]
  contrats     Contrat[]
  factures     Facture[]
  avenants     Avenant[]

  equipements Equipement[]

  @@unique([operationId, code])
  @@index([operationId])
  @@index([parentId])
  @@map("cfc_nodes")
}

enum BudgetVersionStatut {
  BROUILLON
  VALIDE
  ARCHIVE
}

/// Version de budget d'une opération (initial, puis révisions). Une seule « courante ».
model BudgetVersion {
  id          Int                 @id @default(autoincrement())
  operationId Int                 @map("operation_id")
  libelle     String // "Budget initial", "Révision 1"…
  statut      BudgetVersionStatut @default(BROUILLON)
  isCourant   Boolean             @default(false) @map("is_courant")
  commentaire String?
  createdAt   DateTime            @default(now()) @map("created_at")

  operation Operation     @relation(fields: [operationId], references: [id], onDelete: Cascade)
  lignes    LigneBudget[]

  @@index([operationId])
  @@map("budget_versions")
}

/// Ligne de budget rattachée à un poste CFC (dans une version de budget).
model LigneBudget {
  id              Int      @id @default(autoincrement())
  budgetVersionId Int      @map("budget_version_id")
  cfcNodeId       Int      @map("cfc_node_id")
  designation     String?
  quantite        Decimal? @db.Decimal(12, 3)
  prixUnitaire    Decimal? @map("prix_unitaire") @db.Decimal(12, 2)
  montant         Decimal  @db.Decimal(12, 2)
  tvaPct          Decimal? @default(8.10) @map("tva_pct") @db.Decimal(4, 2)
  estReserve      Boolean  @default(false) @map("est_reserve") // provision / imprévus
  note            String?

  budgetVersion BudgetVersion @relation(fields: [budgetVersionId], references: [id], onDelete: Cascade)
  cfcNode       CfcNode       @relation(fields: [cfcNodeId], references: [id])

  @@index([budgetVersionId])
  @@index([cfcNodeId])
  @@map("lignes_budget")
}

// =====================================================================
//  4. ENTREPRISES, SOUMISSIONS, ADJUDICATIONS, CONTRATS
// =====================================================================

/// Répertoire des entreprises (soumissionnaires / adjudicataires) et intervenants.
model Entreprise {
  id          Int      @id @default(autoincrement())
  societeId   Int      @map("societe_id")
  nom         String
  corpsMetier String?  @map("corps_metier") // peinture, gros œuvre, sanitaire…
  contactNom  String?  @map("contact_nom")
  email       String?
  telephone   String?
  ide         String?
  createdAt   DateTime @default(now()) @map("created_at")

  societe     Societe                @relation(fields: [societeId], references: [id], onDelete: Cascade)
  invitations SoumissionInvitation[]
  offres      Offre[]
  contrats    Contrat[]
  factures    Facture[]

  equipements Equipement[]

  @@index([societeId])
  @@map("entreprises")
}

enum SoumissionStatut {
  BROUILLON
  ENVOYEE
  OUVERTE
  EN_COMPARAISON
  ADJUGEE
  INFRUCTUEUSE
  ANNULEE
}

/// Appel d'offres pour un poste CFC / corps de métier.
model Soumission {
  id             Int              @id @default(autoincrement())
  operationId    Int              @map("operation_id")
  cfcNodeId      Int?             @map("cfc_node_id")
  intitule       String
  corpsMetier    String?          @map("corps_metier")
  statut         SoumissionStatut @default(BROUILLON)
  dateEnvoi      DateTime?        @map("date_envoi")
  dateLimite     DateTime?        @map("date_limite")
  /// Le dossier envoyé aux entreprises : ce qu'on demande, et à quelles conditions.
  descriptif     String?          @db.Text
  conditions     String?          @db.Text
  delaiExecution String?          @map("delai_execution")
  /// Offres déposées par l'espace entreprise : invisibles au promoteur avant
  /// la date limite. Ouvertes toutes ensemble — aucune ne peut s'aligner sur
  /// une autre, et personne ne peut en être soupçonné.
  offresScellees Boolean          @default(true) @map("offres_scellees")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  operation    Operation              @relation(fields: [operationId], references: [id], onDelete: Cascade)
  cfcNode      CfcNode?               @relation(fields: [cfcNodeId], references: [id])
  invitations  SoumissionInvitation[]
  offres       Offre[]
  adjudication Adjudication?
  documents    Document[]
  criteres     CritereSoumission[]
  questions    QuestionSoumission[]

  @@index([operationId])
  @@map("soumissions")
}

/// À qui la soumission a été envoyée, et si l'entreprise a répondu.
model SoumissionInvitation {
  id           Int       @id @default(autoincrement())
  soumissionId Int       @map("soumission_id")
  entrepriseId Int       @map("entreprise_id")
  dateEnvoi    DateTime? @map("date_envoi")
  aRepondu     Boolean   @default(false) @map("a_repondu")
  /// L'adresse à laquelle l'invitation est partie — figée : changer l'adresse
  /// de l'entreprise ensuite ne redirige pas un lien déjà envoyé.
  email        String?
  /// Empreinte du lien d'accès à l'espace entreprise. Le lien lui-même n'est
  /// jamais stocké : une copie de la base ne donne accès à aucune consultation.
  jetonHash    String?   @unique @map("jeton_hash")
  revoqueeLe   DateTime? @map("revoquee_le")
  consulteeLe  DateTime? @map("consultee_le")
  /// Code à usage unique envoyé par e-mail : le lien seul ne suffit pas.
  codeHash     String?   @map("code_hash")
  codeExpireLe DateTime? @map("code_expire_le")
  codeEssais   Int       @default(0) @map("code_essais")
  relanceLe    DateTime? @map("relance_le")
  refuseLe     DateTime? @map("refuse_le")
  motifRefus   String?   @map("motif_refus")

  soumission Soumission           @relation(fields: [soumissionId], references: [id], onDelete: Cascade)
  entreprise Entreprise           @relation(fields: [entrepriseId], references: [id])
  questions  QuestionSoumission[]

  @@unique([soumissionId, entrepriseId])
  @@map("soumission_invitations")
}

enum OffreStatut {
  ATTENDUE
  RECUE
  RELANCE
  RETENUE
  ECARTEE
}

enum OffreLigneType {
  OPTION
  VARIANTE
}

/// Une option (en plus de l'offre de base) ou une variante (à sa place).
/// `retenue` se pose à l'adjudication : le montant adjugé en découle.
model OffreLigne {
  id        Int            @id @default(autoincrement())
  offreId   Int            @map("offre_id")
  type      OffreLigneType
  libelle   String
  montant   Decimal        @db.Decimal(12, 2)
  retenue   Boolean        @default(false)
  createdAt DateTime       @default(now()) @map("created_at")

  offre Offre @relation(fields: [offreId], references: [id], onDelete: Cascade)

  @@index([offreId])
  @@map("offre_lignes")
}

/// Un critère d'adjudication et son poids. Le prix est un critère comme un
/// autre, mais sa note se calcule : elle ne se saisit pas.
model CritereSoumission {
  id           Int      @id @default(autoincrement())
  soumissionId Int      @map("soumission_id")
  libelle      String
  /// Pondération en pour-cent ; la somme des critères fait 100.
  poids        Decimal  @db.Decimal(5, 2)
  estPrix      Boolean  @default(false) @map("est_prix")
  ordre        Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at")

  soumission Soumission  @relation(fields: [soumissionId], references: [id], onDelete: Cascade)
  notes      NoteOffre[]

  @@index([soumissionId])
  @@map("criteres_soumission")
}

/// La note d'une offre sur un critère, de 0 à 10, avec sa justification.
model NoteOffre {
  id          Int      @id @default(autoincrement())
  offreId     Int      @map("offre_id")
  critereId   Int      @map("critere_id")
  note        Decimal  @db.Decimal(4, 2)
  commentaire String?
  /// Membership qui a noté.
  noteParId   Int?     @map("note_par_id")
  updatedAt   DateTime @updatedAt @map("updated_at")

  offre   Offre             @relation(fields: [offreId], references: [id], onDelete: Cascade)
  critere CritereSoumission @relation(fields: [critereId], references: [id], onDelete: Cascade)

  @@unique([offreId, critereId])
  @@map("notes_offres")
}

/// Une question d'un soumissionnaire, et la réponse. Publiée, la réponse part
/// à TOUS les invités, sans le nom de celui qui a demandé : l'égalité de
/// traitement entre soumissionnaires en dépend.
model QuestionSoumission {
  id           Int       @id @default(autoincrement())
  soumissionId Int       @map("soumission_id")
  invitationId Int?      @map("invitation_id")
  question     String    @db.Text
  reponse      String?   @db.Text
  reponduLe    DateTime? @map("repondu_le")
  publiee      Boolean   @default(false)
  createdAt    DateTime  @default(now()) @map("created_at")

  soumission Soumission            @relation(fields: [soumissionId], references: [id], onDelete: Cascade)
  invitation SoumissionInvitation? @relation(fields: [invitationId], references: [id], onDelete: SetNull)

  @@index([soumissionId])
  @@map("questions_soumission")
}

/// Offre (prix) reçue d'une entreprise pour une soumission.
model Offre {
  id            Int         @id @default(autoincrement())
  soumissionId  Int         @map("soumission_id")
  entrepriseId  Int         @map("entreprise_id")
  montant       Decimal?    @db.Decimal(12, 2)
  remisePct     Decimal?    @map("remise_pct") @db.Decimal(4, 2)
  statut        OffreStatut @default(ATTENDUE)
  dateReception DateTime?   @map("date_reception")
  note          String?
  /// SAISIE (par le promoteur) ou PORTAIL (déposée par l'entreprise).
  source        String      @default("SAISIE")
  createdAt     DateTime    @default(now()) @map("created_at")

  soumission   Soumission    @relation(fields: [soumissionId], references: [id], onDelete: Cascade)
  entreprise   Entreprise    @relation(fields: [entrepriseId], references: [id])
  adjudication Adjudication?
  lignes       OffreLigne[]
  notes        NoteOffre[]
  documents    Document[]

  @@index([soumissionId])
  @@map("offres")
}

/// Décision d'adjudication : l'offre retenue pour une soumission.
model Adjudication {
  id            Int      @id @default(autoincrement())
  soumissionId  Int      @unique @map("soumission_id")
  offreId       Int      @unique @map("offre_id")
  montantAdjuge Decimal  @map("montant_adjuge") @db.Decimal(12, 2)
  dateDecision  DateTime @default(now()) @map("date_decision")
  decidePar     Int?     @map("decide_par") // utilisateurId
  commentaire   String?

  soumission Soumission @relation(fields: [soumissionId], references: [id], onDelete: Cascade)
  offre      Offre      @relation(fields: [offreId], references: [id])
  contrat    Contrat?

  @@map("adjudications")
}

enum ContratStatut {
  BROUILLON
  SIGNE
  EN_COURS
  RECEPTION
  SOLDE
  RESILIE
}

/// Contrat d'entreprise (référence norme SIA 118).
model Contrat {
  id                 Int           @id @default(autoincrement())
  operationId        Int           @map("operation_id")
  entrepriseId       Int           @map("entreprise_id")
  cfcNodeId          Int?          @map("cfc_node_id")
  adjudicationId     Int?          @unique @map("adjudication_id")
  reference          String?
  montant            Decimal       @db.Decimal(12, 2)
  retenueGarantiePct Decimal?      @map("retenue_garantie_pct") @db.Decimal(4, 2)
  statut             ContratStatut @default(BROUILLON)
  dateSignature      DateTime?     @map("date_signature")
  dateReception      DateTime?     @map("date_reception") // réception de l'ouvrage
  finGarantie        DateTime?     @map("fin_garantie") // délai de garantie (2 ans)
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  operation    Operation     @relation(fields: [operationId], references: [id], onDelete: Cascade)
  entreprise   Entreprise    @relation(fields: [entrepriseId], references: [id])
  cfcNode      CfcNode?      @relation(fields: [cfcNodeId], references: [id])
  adjudication Adjudication? @relation(fields: [adjudicationId], references: [id])
  avenants     Avenant[]
  factures     Facture[]
  documents    Document[]

  equipements Equipement[]

  @@index([operationId])
  @@index([entrepriseId])
  @@map("contrats")
}

/// Avenant (travaux en plus / en moins) rattaché à un contrat et à un CFC.
model Avenant {
  id          Int      @id @default(autoincrement())
  contratId   Int      @map("contrat_id")
  cfcNodeId   Int?     @map("cfc_node_id")
  reference   String?
  montant     Decimal  @db.Decimal(12, 2) // signé : + ou −
  motif       String?
  dateAvenant DateTime @default(now()) @map("date_avenant")

  contrat Contrat  @relation(fields: [contratId], references: [id], onDelete: Cascade)
  cfcNode CfcNode? @relation(fields: [cfcNodeId], references: [id])

  @@index([contratId])
  @@map("avenants")
}

// =====================================================================
//  5. FACTURES (avec lecture OCR/IA) & PAIEMENTS FOURNISSEURS
// =====================================================================

enum FactureType {
  SITUATION // état d'avancement
  ACOMPTE
  SOLDE
  AVOIR
}

enum FactureStatut {
  RECUE
  EN_LECTURE // OCR/IA en cours
  A_VALIDER
  VALIDEE
  PAYEE
  LITIGE
  REJETEE
}

enum OcrStatut {
  EN_ATTENTE
  TRAITEE
  ECHOUEE
}

/// Facture d'un corps de métier. Lue automatiquement (OCR/IA) puis classée au CFC.
model Facture {
  id           Int           @id @default(autoincrement())
  societeId    Int           @map("societe_id")
  operationId  Int           @map("operation_id")
  contratId    Int?          @map("contrat_id")
  entrepriseId Int?          @map("entreprise_id")
  cfcNodeId    Int?          @map("cfc_node_id") // CFC validé
  type         FactureType   @default(SITUATION)
  statut       FactureStatut @default(RECUE)

  numero      String?
  dateFacture DateTime? @map("date_facture")
  montantHT   Decimal?  @map("montant_ht") @db.Decimal(12, 2)
  tvaPct      Decimal?  @map("tva_pct") @db.Decimal(4, 2)
  montantTTC  Decimal?  @map("montant_ttc") @db.Decimal(12, 2)

  // Lecture automatique (OCR/IA)
  fichierUrl   String?   @map("fichier_url")
  ocrStatut    OcrStatut @default(EN_ATTENTE) @map("ocr_statut")
  ocrTexte     String?   @map("ocr_texte")
  cfcSuggereId Int?      @map("cfc_suggere_id") // CFC proposé par l'IA
  ocrConfiance Decimal?  @map("ocr_confiance") @db.Decimal(5, 2)

  // Validation humaine
  validePar      Int?      @map("valide_par")
  dateValidation DateTime? @map("date_validation")

  // Capture — la pièce d'origine, conservée telle quelle : c'est la preuve.
  /// SAISIE, UPLOAD, CAMERA, EMAIL — pour le diagnostic, jamais pour un
  /// traitement différent.
  source         String  @default("SAISIE")
  fichierCle     String? @map("fichier_cle")
  fichierNom     String? @map("fichier_nom")
  fichierMime    String? @map("fichier_mime")
  fichierTaille  Int?    @map("fichier_taille")
  /// Empreinte SHA-256 : la même pièce déposée deux fois ne fait pas deux factures.
  fichierSha256  String? @map("fichier_sha256")
  lectureMethode String? @map("lecture_methode")
  lectureErreur  String? @map("lecture_erreur")
  /// Ce que la lecture a proposé, champ par champ, avec son ancrage dans le
  /// texte (ancrée / proposée / absente) et l'extrait qui la justifie.
  lecture        Json?

  // Ce que la facture dit en plus des montants
  montantTVA      Decimal?  @map("montant_tva") @db.Decimal(12, 2)
  retenueGarantie Decimal?  @map("retenue_garantie") @db.Decimal(12, 2)
  /// Acomptes antérieurs que la facture déclare déduire (situation cumulative).
  acomptesDeduits Decimal?  @map("acomptes_deduits") @db.Decimal(12, 2)
  dateEcheance    DateTime? @map("date_echeance")
  iban            String?
  referenceQR     String?   @map("reference_qr")

  /// Le rapport de contrôle — calculé par le code, jamais par le modèle.
  controles  Json?
  controleLe DateTime? @map("controle_le")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  societe    Societe               @relation(fields: [societeId], references: [id], onDelete: Cascade)
  operation  Operation             @relation(fields: [operationId], references: [id], onDelete: Cascade)
  contrat    Contrat?              @relation(fields: [contratId], references: [id])
  entreprise Entreprise?           @relation(fields: [entrepriseId], references: [id])
  cfcNode    CfcNode?              @relation(fields: [cfcNodeId], references: [id])
  paiements  PaiementFournisseur[]
  documents  Document[]
  lignes     FactureLigne[]
  visas      FactureVisa[]

  @@unique([societeId, fichierSha256])
  @@index([operationId])
  @@index([cfcNodeId])
  @@index([statut])
  @@map("factures")
}

/// Une ligne de facture : ce qui est facturé, et à quel poste CFC.
model FactureLigne {
  id          Int     @id @default(autoincrement())
  factureId   Int     @map("facture_id")
  designation String
  /// Code CFC ou position tel qu'écrit sur la facture (« 211.32 »).
  codeCfc     String? @map("code_cfc")
  montant     Decimal @db.Decimal(12, 2)
  ordre       Int     @default(0)

  facture Facture @relation(fields: [factureId], references: [id], onDelete: Cascade)

  @@index([factureId])
  @@map("facture_lignes")
}

enum VisaEtape {
  /// La direction des travaux, quand l'opération en a nommé une.
  DIRECTION_TRAVAUX
  PROMOTEUR
}

enum VisaDecision {
  APPROUVE
  REFUSE
}

/// Chaque signature du circuit de validation : qui, à quelle étape, quand,
/// et pourquoi. Un visa ne se modifie pas ; un nouvel avis s'ajoute.
model FactureVisa {
  id          Int          @id @default(autoincrement())
  factureId   Int          @map("facture_id")
  etape       VisaEtape
  decision    VisaDecision
  parId       Int          @map("par_id")
  commentaire String?
  createdAt   DateTime     @default(now()) @map("created_at")

  facture Facture @relation(fields: [factureId], references: [id], onDelete: Cascade)

  @@index([factureId])
  @@map("facture_visas")
}

/// Paiement effectué à une entreprise (rapprochement ISO 20022 pain/camt).
model PaiementFournisseur {
  id         Int      @id @default(autoincrement())
  factureId  Int      @map("facture_id")
  montant    Decimal  @db.Decimal(12, 2)
  dateValeur DateTime @map("date_valeur")
  moyen      String? // virement, QR…
  reference  String?
  createdAt  DateTime @default(now()) @map("created_at")

  facture Facture @relation(fields: [factureId], references: [id], onDelete: Cascade)

  @@index([factureId])
  @@map("paiements_fournisseurs")
}

// =====================================================================
//  6. VENTES : ACQUÉREURS, RÉSERVATIONS, ÉCHÉANCIER, APPELS DE FONDS
// =====================================================================

enum ReservationStatut {
  OPTION
  RESERVE
  FONDS_VERSES
  VENDU
  EXPIREE
  ANNULEE
}

/// Une **personne** d'un dossier acquéreur. Un dossier (une réservation) en
/// compte N : couple, indivision, société. Mappé au client d'une réservation
/// Kolabimo, qui ne livre l'identité qu'au palier FONDS_VERSES.
model Acquereur {
  id        Int     @id @default(autoincrement())
  societeId Int     @map("societe_id")
  nom       String?
  prenom    String?
  email     String?
  telephone String?
  adresse   String?

  // Complément d'identité livré par Kolabimo à FONDS_VERSES.
  type          String? // PHYSIQUE, MORALE
  dateNaissance DateTime? @map("date_naissance")
  nationalite   String?
  npa           String?
  localite      String?
  pays          String?
  raisonSociale String?   @map("raison_sociale")
  ide           String?

  /// Référence du **dossier** Kolabimo — partagée par toutes ses personnes.
  kolabimoClientRef String? @map("kolabimo_client_ref")
  /// Rang de la personne dans son dossier : c'est lui qui, avec la référence,
  /// rend l'upsert stable d'un événement à l'autre. Kolabimo ne donne pas
  /// d'identifiant par personne.
  ordre             Int     @default(0)

  createdAt DateTime @default(now()) @map("created_at")

  societe      Societe                @relation(fields: [societeId], references: [id], onDelete: Cascade)
  reservations Reservation[]
  dossiers     ReservationAcquereur[]

  @@unique([societeId, kolabimoClientRef, ordre], name: "acquereur_dossier_rang")
  @@index([societeId])
  @@map("acquereurs")
}

/// Le lien entre un dossier (réservation) et une de ses personnes.
///
/// La quote-part est une **fraction** — « 1/2 », « 1/3 » — et non un
/// pourcentage : c'est ce que porte l'acte notarié, et arrondir 1/3 en 33,33 %
/// ferait perdre la somme exacte. Les appels de fonds restent **solidaires** :
/// le montant n'est pas divisé, tous les destinataires reçoivent la lettre.
model ReservationAcquereur {
  id            Int     @id @default(autoincrement())
  reservationId Int     @map("reservation_id")
  acquereurId   Int     @map("acquereur_id")
  role          String
  quotePart     String? @map("quote_part")
  signataire    Boolean @default(false)
  ordre         Int     @default(0)

  createdAt DateTime @default(now()) @map("created_at")

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  acquereur   Acquereur   @relation(fields: [acquereurId], references: [id], onDelete: Cascade)

  @@unique([reservationId, acquereurId])
  @@index([reservationId])
  @@map("reservation_acquereurs")
}

/// Réservation d'un lot par un acquéreur. Miroir d'une réservation Kolabimo
/// (idempotence via externalId, comme côté Kolabimo).
model Reservation {
  id          Int               @id @default(autoincrement())
  operationId Int               @map("operation_id")
  lotId       Int               @map("lot_id")
  /// Contact principal du dossier — **dérivé** de `acquereurs` (le signataire,
  /// à défaut la première personne). Nul tant que Kolabimo n'a pas livré
  /// l'identité : avant `FONDS_VERSES`, une réservation n'a qu'une référence.
  acquereurId Int?              @map("acquereur_id")
  statut      ReservationStatut @default(OPTION)

  // Prix total acte figé au moment de la vente (prix lot + Σ parkings).
  prixTotalActe     Decimal?  @map("prix_total_acte") @db.Decimal(12, 2)
  dateReservation   DateTime  @default(now()) @map("date_reservation")
  dateSignatureActe DateTime? @map("date_signature_acte")

  // Notaire du lot — peut différer du notaire de la promotion (comme dans Kolabimo).
  notaireActeurId Int? @map("notaire_acteur_id")

  // Passerelle Kolabimo
  externalId            String? @unique @map("external_id")
  kolabimoReservationId Int?    @map("kolabimo_reservation_id")
  /// Référence pseudonyme du dossier — seule identité connue avant FONDS_VERSES.
  kolabimoClientRef     String? @map("kolabimo_client_ref")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  operation           Operation              @relation(fields: [operationId], references: [id], onDelete: Cascade)
  lot                 Lot                    @relation(fields: [lotId], references: [id])
  acquereur           Acquereur?             @relation(fields: [acquereurId], references: [id])
  acquereurs          ReservationAcquereur[]
  notaireActeur       Acteur?                @relation("ReservationNotaire", fields: [notaireActeurId], references: [id])
  appelsDeFonds       AppelDeFonds[]
  documents           Document[]
  commissionsCourtage CommissionCourtage[]

  @@index([operationId])
  @@index([lotId])
  @@map("reservations")
}

/// Statut aligné sur Kolabimo (EcheancierEtapeStatut).
enum EcheancierEtapeStatut {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

/// Jalon de paiement de l'opération. MAÎTRE dans ce SaaS (décision de fin d'étape),
/// synchronisé vers Kolabimo. Σ des pourcentages = 100 %.
/// Passer une étape à COMPLETED (avec dateCompletion) déclenche les appels de fonds.
model EcheancierEtape {
  id              Int                   @id @default(autoincrement())
  operationId     Int                   @map("operation_id")
  ordre           Int
  libelle         String
  description     String?
  // % du prix appelé À CETTE ÉTAPE (surcouche promoteur). Null = simple jalon de
  // chantier (suivi des étapes par une EG / un architecte, sans appel de fonds).
  pourcentage     Decimal?              @db.Decimal(5, 2)
  statut          EcheancierEtapeStatut @default(NOT_STARTED)
  dateCompletion  DateTime?             @map("date_completion") // fin RÉELLE (déclencheur)
  datePrevue      DateTime?             @map("date_prevue") // fin estimée (projection)
  // Traçabilité de la synchro vers Kolabimo
  kolabimoEtapeId Int?                  @map("kolabimo_etape_id")
  syncedAt        DateTime?             @map("synced_at")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")

  operation     Operation      @relation(fields: [operationId], references: [id], onDelete: Cascade)
  appelsDeFonds AppelDeFonds[]

  @@unique([operationId, ordre])
  @@index([operationId])
  @@map("echeancier_etapes")
}

enum AppelDeFondsStatut {
  BROUILLON
  EMIS
  ENVOYE
  PARTIELLEMENT_PAYE
  PAYE
  EN_RETARD
  ANNULE
}

/// Appel de fonds envoyé à un acquéreur pour une étape.
/// montant = pourcentage de l'étape × prix total acte du lot.
/// Unicité (reservationId, etapeId) : idempotence de la génération automatique.
model AppelDeFonds {
  id            Int                @id @default(autoincrement())
  reservationId Int                @map("reservation_id")
  etapeId       Int                @map("etape_id")
  numero        String?
  pourcentage   Decimal            @db.Decimal(5, 2)
  montant       Decimal            @db.Decimal(12, 2)
  statut        AppelDeFondsStatut @default(BROUILLON)
  dateEmission  DateTime?          @map("date_emission")
  dateEnvoi     DateTime?          @map("date_envoi")
  dateEcheance  DateTime?          @map("date_echeance")
  fichierUrl    String?            @map("fichier_url") // PDF de l'appel de fonds
  qrReference   String?            @map("qr_reference") // référence QR-facture suisse
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  reservation   Reservation     @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  etape         EcheancierEtape @relation(fields: [etapeId], references: [id])
  encaissements Encaissement[]

  @@unique([reservationId, etapeId])
  @@index([reservationId])
  @@index([statut])
  @@map("appels_de_fonds")
}

/// Encaissement reçu d'un acquéreur (rapprochement ISO 20022 camt.053/054).
model Encaissement {
  id               Int       @id @default(autoincrement())
  appelDeFondsId   Int       @map("appel_de_fonds_id")
  montant          Decimal   @db.Decimal(12, 2)
  dateValeur       DateTime  @map("date_valeur")
  reference        String? // référence QR rapprochée
  source           String? // "camt.054", "saisie", "notaire"…
  // Validation de l'arrivée des fonds (ex. par le notaire ayant un accès APPELS_FONDS).
  confirmeParId    Int?      @map("confirme_par_id")
  dateConfirmation DateTime? @map("date_confirmation")
  createdAt        DateTime  @default(now()) @map("created_at")

  appelDeFonds AppelDeFonds @relation(fields: [appelDeFondsId], references: [id], onDelete: Cascade)

  @@index([appelDeFondsId])
  @@map("encaissements")
}

// =====================================================================
//  7. PASSERELLE / INTÉGRATION & AUDIT
// =====================================================================

enum WebhookEventStatut {
  RECU
  TRAITE
  IGNORE
  ERREUR
}

/// Journal des événements entrants (webhooks Kolabimo, ex. echeancier.etape_completed).
/// dedupeKey garantit l'idempotence du traitement.
model WebhookEvent {
  id          Int                @id @default(autoincrement())
  source      String             @default("kolabimo")
  evenement   String // "echeancier.etape_completed"…
  dedupeKey   String             @unique @map("dedupe_key")
  payload     Json
  statut      WebhookEventStatut @default(RECU)
  erreur      String?
  receivedAt  DateTime           @default(now()) @map("received_at")
  processedAt DateTime?          @map("processed_at")

  @@index([evenement, statut])
  // Le journal de synchronisation se lit du plus récent au plus ancien.
  @@index([receivedAt(sort: Desc)])
  @@map("webhook_events")
}

/// Piste d'audit des actions sensibles (adjudication, validation facture,
/// émission d'appel de fonds, changement de budget…).
model AuditLog {
  id            Int      @id @default(autoincrement())
  societeId     Int      @map("societe_id")
  utilisateurId Int?     @map("utilisateur_id")
  action        String // "facture.validee", "etape.completed"…
  entite        String // "Facture", "AppelDeFonds"…
  entiteId      Int?     @map("entite_id")
  donnees       Json?
  /// Adresse du client — relayée par Next et vérifiée par secret. Nulle pour
  /// une action sans requête humaine (webhook, traitement planifié).
  ip            String?
  userAgent     String?  @map("user_agent")
  createdAt     DateTime @default(now()) @map("created_at")

  societe Societe @relation(fields: [societeId], references: [id], onDelete: Cascade)

  @@index([societeId, createdAt])
  @@map("audit_logs")
}

/// Journal des connexions — réussies, refusées, bloquées.
///
/// Séparé de `audit_logs` parce qu'une connexion précède le choix d'une
/// société : elle n'a pas de tenant. Exemptée de RLS pour la même raison que
/// `comptes`, et filtrée par compte dans le code.
///
/// **Aucune adresse e-mail n'y est écrite.** Un échec sur une adresse
/// inconnue laisse `compteId` nul : garder l'adresse tapée reviendrait à
/// conserver les fautes de frappe — et les tentatives — de n'importe qui.
model JournalConnexion {
  id        Int      @id @default(autoincrement())
  compteId  Int?     @map("compte_id")
  /// CONNEXION_REUSSIE, ECHEC_MOT_DE_PASSE, ECHEC_MFA, BLOQUE, MFA_REUSSI
  evenement String
  ip        String?
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([compteId, createdAt])
  @@map("journal_connexions")
}

// =====================================================================
//  8. GED — DOCUMENTS DE LA PROMOTION
//     Mandats, contrats, factures, actes de vente, plans/projets, permis,
//     garanties, PV, assurances, financement… rattachables à l'opération et,
//     plus finement, à un lot, un contrat, une facture, une réservation, un acteur.
// =====================================================================

enum DocumentCategorie {
  MANDAT
  CONTRAT
  DEVIS
  SOUMISSION
  FACTURE
  ACTE_VENTE
  RESERVATION
  PLAN
  PROJET
  PERMIS
  AUTORISATION
  EXTRAIT_RF
  PPE_ACTE_CONSTITUTIF
  PPE_REGLEMENT
  PPE_PLAN
  MANDAT_COURTAGE
  GARANTIE
  PV_RECEPTION
  PV_SEANCE
  NOTE
  PHOTO_CHANTIER
  ASSURANCE
  FINANCEMENT
  ADMINISTRATIF
  // Passeport numérique de l'ouvrage
  NOTICE
  CERTIFICAT
  CONTRAT_ENTRETIEN
  AUTRE
}

model Document {
  id          Int               @id @default(autoincrement())
  societeId   Int               @map("societe_id")
  categorie   DocumentCategorie @default(AUTRE)
  titre       String
  description String?

  // Fichier
  fileName String @map("file_name")
  filePath String @map("file_path") // clé object storage (S3/CH)
  mimeType String @map("mime_type")
  fileSize Int    @map("file_size")

  // Versionnage
  version          Int     @default(1)
  isCourant        Boolean @default(true) @map("is_courant")
  parentDocumentId Int?    @map("parent_document_id")

  // Partage externe (notaire, banque, acquéreur…)
  visibiliteExterne Boolean @default(false) @map("visibilite_externe")

  uploadedById Int?     @map("uploaded_by_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Rattachements optionnels (l'opération est le contexte le plus fréquent)
  operationId      Int? @map("operation_id")
  lotId            Int? @map("lot_id")
  soumissionId     Int? @map("soumission_id")
  /// La pièce d'une offre (le PDF déposé par l'entreprise).
  offreId          Int? @map("offre_id")
  contratId        Int? @map("contrat_id")
  factureId        Int? @map("facture_id")
  reservationId    Int? @map("reservation_id")
  acteurId         Int? @map("acteur_id")
  seanceId         Int? @map("seance_id")
  parcelleId       Int? @map("parcelle_id")
  ppeId            Int? @map("ppe_id")
  mandatCourtageId Int? @map("mandat_courtage_id")
  /// Notice, garantie, certificat d'un équipement du passeport.
  equipementId     Int? @map("equipement_id")

  societe        Societe         @relation(fields: [societeId], references: [id], onDelete: Cascade)
  operation      Operation?      @relation(fields: [operationId], references: [id], onDelete: Cascade)
  lot            Lot?            @relation(fields: [lotId], references: [id])
  soumission     Soumission?     @relation(fields: [soumissionId], references: [id])
  offre          Offre?          @relation(fields: [offreId], references: [id], onDelete: SetNull)
  contrat        Contrat?        @relation(fields: [contratId], references: [id])
  facture        Facture?        @relation(fields: [factureId], references: [id])
  reservation    Reservation?    @relation(fields: [reservationId], references: [id])
  acteur         Acteur?         @relation(fields: [acteurId], references: [id])
  seance         Seance?         @relation(fields: [seanceId], references: [id])
  parcelle       Parcelle?       @relation(fields: [parcelleId], references: [id])
  ppe            Ppe?            @relation(fields: [ppeId], references: [id])
  mandatCourtage MandatCourtage? @relation(fields: [mandatCourtageId], references: [id])
  parent         Document?       @relation("DocumentVersions", fields: [parentDocumentId], references: [id])
  versions       Document[]      @relation("DocumentVersions")

  equipement   Equipement?  @relation("DocumentEquipement", fields: [equipementId], references: [id], onDelete: SetNull)
  /// Les équipements proposés à partir de ce document.
  propositions Equipement[] @relation("PropositionSource")

  @@index([societeId])
  @@index([operationId, categorie])
  @@map("documents")
}

// =====================================================================
//  9. SÉANCES, PRISE DE NOTES & PV
//     Différents types de séances (chantier, adjudication, COPIL, client…),
//     avec prise de notes et génération de PV. Le PV et les notes sont
//     stockés comme Documents (categorie PV_SEANCE / NOTE) rattachés à la séance.
// =====================================================================

enum SeanceType {
  CHANTIER
  ADJUDICATION
  COPIL // comité de pilotage
  PROMOTEUR // interne promoteur
  TECHNIQUE // architecte / ingénieurs
  CLIENT_ACQUEREUR
  NOTAIRE
  AUTRE
}

enum SeanceStatut {
  PLANIFIEE
  TENUE
  ANNULEE
}

/// Une séance/réunion rattachée à une opération.
model Seance {
  id          Int          @id @default(autoincrement())
  societeId   Int          @map("societe_id")
  operationId Int          @map("operation_id")
  type        SeanceType   @default(CHANTIER)
  titre       String
  statut      SeanceStatut @default(PLANIFIEE)
  date        DateTime?
  lieu        String?
  ordreDuJour String?      @map("ordre_du_jour")
  notes       String? // prise de notes libre
  numero      String? // n° de séance (ex. "Chantier #12")
  createdById Int?         @map("created_by_id")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  operation    Operation           @relation(fields: [operationId], references: [id], onDelete: Cascade)
  participants SeanceParticipant[]
  points       SeancePoint[]
  documents    Document[] // PV généré, pièces jointes

  @@index([operationId, date])
  @@map("seances")
}

/// Participant à une séance : utilisateur interne, acteur (notaire, architecte…),
/// ou personne libre. Avec présence.
model SeanceParticipant {
  id           Int     @id @default(autoincrement())
  seanceId     Int     @map("seance_id")
  membershipId Int?    @map("membership_id")
  acteurId     Int?    @map("acteur_id")
  nom          String? // si participant hors annuaire
  organisation String?
  email        String?
  present      Boolean @default(true)

  seance Seance @relation(fields: [seanceId], references: [id], onDelete: Cascade)

  @@index([seanceId])
  @@map("seance_participants")
}

enum SeancePointStatut {
  OUVERT
  EN_COURS
  CLOS
}

/// Point de l'ordre du jour / décision / action d'une séance (base du PV).
model SeancePoint {
  id          Int               @id @default(autoincrement())
  seanceId    Int               @map("seance_id")
  ordre       Int               @default(0)
  titre       String
  contenu     String? // note / décision
  responsable String? // qui doit agir
  echeance    DateTime?
  statut      SeancePointStatut @default(OUVERT)
  cfcNodeId   Int?              @map("cfc_node_id") // rattachement CFC éventuel
  createdAt   DateTime          @default(now()) @map("created_at")

  seance Seance @relation(fields: [seanceId], references: [id], onDelete: Cascade)

  @@index([seanceId])
  @@map("seance_points")
}

// =====================================================================
//  10. PARCELLES & REGISTRE FONCIER
// =====================================================================

/// Parcelle cadastrale de l'opération. Porte ses documents (extraits du
/// registre foncier, plans cadastraux…). Une opération peut couvrir plusieurs parcelles.
/// Taux de frais d'acquisition d'un terrain, par canton.
///
/// Notaire, registre foncier et droits de mutation varient d'un canton à
/// l'autre — environ 3 % en Valais. Le taux sert à ESTIMER ces frais tant
/// qu'ils ne sont pas connus ; dès qu'ils sont saisis sur la promotion, ce
/// sont eux qui comptent et l'estimation disparaît.
///
/// Paramétré par société : deux promoteurs n'ont ni le même notaire ni la
/// même pratique, et aucun barème officiel ne peut être codé en dur ici.
model TauxFraisAcquisition {
  id          Int      @id @default(autoincrement())
  societeId   Int      @map("societe_id")
  /// Sigle du canton : « VS », « VD », « GE »…
  canton      String   @db.VarChar(2)
  pourcentage Decimal  @db.Decimal(5, 2)
  note        String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  societe Societe @relation(fields: [societeId], references: [id], onDelete: Cascade)

  @@unique([societeId, canton])
  @@index([societeId])
  @@map("taux_frais_acquisition")
}

/// Nature d'un découpage de parcelle, tel qu'il figure à l'extrait RDPPF.
///
/// Une parcelle n'est pas homogène : elle peut porter deux zones
/// d'affectation et deux degrés de sensibilité au bruit, chacun sur une part
/// de sa surface. Une seule table pour les deux — et pour les thèmes RDPPF
/// suivants — plutôt qu'une table par couche.
enum ParcelleDecoupageType {
  ZONE_AFFECTATION
  DEGRE_SENSIBILITE_BRUIT
  AUTRE
}

/// Une part de parcelle : « Zone d'habitat collectif B (3) — 1706 m² — 100 % ».
model ParcelleDecoupage {
  id          Int                   @id @default(autoincrement())
  parcelleId  Int                   @map("parcelle_id")
  type        ParcelleDecoupageType
  libelle     String
  surfaceM2   Decimal?              @map("surface_m2") @db.Decimal(12, 2)
  /// Part de la parcelle, en pour-cent. Reprise telle quelle de l'extrait :
  /// on ne la recalcule pas depuis la surface, les deux figurent au document
  /// et peuvent différer d'un arrondi.
  pourcentage Decimal?              @db.Decimal(6, 2)
  /// Indice propre à CETTE zone, quand il diffère de celui de la parcelle.
  ibus        Decimal?              @db.Decimal(6, 3)
  createdAt   DateTime              @default(now()) @map("created_at")

  parcelle Parcelle @relation(fields: [parcelleId], references: [id], onDelete: Cascade)

  @@index([parcelleId])
  @@map("parcelle_decoupages")
}

model Parcelle {
  id              Int      @id @default(autoincrement())
  operationId     Int      @map("operation_id")
  numero          String // n° de parcelle
  egrid           String? // identifiant fédéral E-GRID
  commune         String?
  surfaceM2       Decimal? @map("surface_m2") @db.Decimal(12, 2)
  affectationZone String?  @map("affectation_zone") // zone d'affectation
  registreFoncier String?  @map("registre_foncier") // référence RF
  /// Lien vers le géoportail cantonal, centré sur la parcelle.
  ///
  /// Ces URL portent les coordonnées et les couches choisies : les recopier
  /// évite de rechercher la parcelle à chaque fois. Rien n'est appelé depuis
  /// le serveur — c'est un signet, pas une intégration.
  lienGeoportail  String?  @map("lien_geoportail")
  /// Lien vers l'extrait RDPPF — cadastre des restrictions de droit public à
  /// la propriété foncière. C'est la pièce qui dit ce qui grève la parcelle.
  lienRdppf       String?  @map("lien_rdppf")
  /// Prix d'achat de CETTE parcelle. Le prix au m² s'en déduit — il ne se
  /// stocke pas : deux champs qui doivent s'accorder finissent par diverger.
  prixAchat       Decimal? @map("prix_achat") @db.Decimal(12, 2)
  /// Indice brut d'utilisation du sol. Multiplié par la surface, il donne la
  /// surface brute de plancher constructible — le premier chiffre qui dit si
  /// une opération tient sur un terrain.
  ibus            Decimal? @db.Decimal(6, 3)
  note            String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  operation  Operation           @relation(fields: [operationId], references: [id], onDelete: Cascade)
  documents  Document[]
  decoupages ParcelleDecoupage[]

  @@index([operationId])
  @@map("parcelles")
}

// =====================================================================
//  11. CONSTITUTION DE PPE (propriété par étages)
// =====================================================================

/// Constitution de la PPE : acte constitutif, règlement d'administration,
/// plans de répartition. Les quotes-parts des lots (Lot.quotePartPPE) s'y rapportent.
model Ppe {
  id                  Int       @id @default(autoincrement())
  operationId         Int       @map("operation_id")
  bienId              Int?      @map("bien_id") // immeuble concerné, si applicable
  numero              String?
  dateActeConstitutif DateTime? @map("date_acte_constitutif")
  notaireActeurId     Int?      @map("notaire_acteur_id")
  totalMillemes       Int       @default(1000) @map("total_millemes")
  note                String?
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  operation Operation  @relation(fields: [operationId], references: [id], onDelete: Cascade)
  documents Document[]

  @@index([operationId])
  @@map("ppes")
}

// =====================================================================
//  12. COURTIERS & MANDATS DE COURTAGE
// =====================================================================

enum CommissionType {
  POURCENTAGE
  FORFAIT
}

enum CourtagePerimetre {
  TOUTE_OPERATION
  LOTS_SELECTIONNES
}

enum MandatStatut {
  BROUILLON
  SIGNE
  ACTIF
  TERMINE
  RESILIE
}

enum CommissionStatut {
  DUE
  FACTUREE
  PAYEE
  ANNULEE
}

/// Mandat de courtage signé avec un courtier (un Acteur de type COURTIER).
/// Définit la commission (%, ou forfait) et le périmètre (toute l'opération ou lots choisis).
model MandatCourtage {
  id                Int               @id @default(autoincrement())
  operationId       Int               @map("operation_id")
  courtierActeurId  Int               @map("courtier_acteur_id")
  commissionType    CommissionType    @default(POURCENTAGE) @map("commission_type")
  commissionPct     Decimal?          @map("commission_pct") @db.Decimal(5, 2)
  commissionForfait Decimal?          @map("commission_forfait") @db.Decimal(12, 2)
  assietteTtc       Boolean           @default(false) @map("assiette_ttc") // commission sur prix TTC ?
  perimetre         CourtagePerimetre @default(TOUTE_OPERATION)
  exclusif          Boolean           @default(false)
  dateSignature     DateTime?         @map("date_signature")
  statut            MandatStatut      @default(BROUILLON)
  notes             String?
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  operation   Operation            @relation(fields: [operationId], references: [id], onDelete: Cascade)
  courtier    Acteur               @relation("CourtierMandat", fields: [courtierActeurId], references: [id])
  lots        MandatCourtageLot[]
  commissions CommissionCourtage[]
  documents   Document[] // le contrat de courtage signé

  @@index([operationId])
  @@index([courtierActeurId])
  @@map("mandats_courtage")
}

/// Lots couverts par un mandat, quand le périmètre = LOTS_SELECTIONNES.
model MandatCourtageLot {
  id               Int @id @default(autoincrement())
  mandatCourtageId Int @map("mandat_courtage_id")
  lotId            Int @map("lot_id")

  mandatCourtage MandatCourtage @relation(fields: [mandatCourtageId], references: [id], onDelete: Cascade)
  lot            Lot            @relation(fields: [lotId], references: [id])

  @@unique([mandatCourtageId, lotId])
  @@map("mandat_courtage_lots")
}

/// Commission due à un courtier sur une vente (réservation) donnée.
model CommissionCourtage {
  id               Int              @id @default(autoincrement())
  mandatCourtageId Int              @map("mandat_courtage_id")
  reservationId    Int              @map("reservation_id")
  montant          Decimal          @db.Decimal(12, 2)
  statut           CommissionStatut @default(DUE)
  dateDue          DateTime?        @map("date_due")
  note             String?
  createdAt        DateTime         @default(now()) @map("created_at")

  mandatCourtage MandatCourtage @relation(fields: [mandatCourtageId], references: [id], onDelete: Cascade)
  reservation    Reservation    @relation(fields: [reservationId], references: [id])

  @@index([mandatCourtageId])
  @@index([reservationId])
  @@map("commissions_courtage")
}

// =====================================================================
//  13. ACCÈS PAR OPÉRATION & DROITS (RBAC scopé)
//     Permet de donner à une EG ou à un architecte mandaté un accès à UNE
//     opération, avec un niveau (lecture / saisie / gestion) et, au besoin,
//     une restriction par module (ex. SOUMISSIONS uniquement).
//     La matrice fine rôle → action est appliquée côté application.
// =====================================================================

model OperationAccess {
  id           Int                  @id @default(autoincrement())
  operationId  Int                  @map("operation_id")
  membershipId Int                  @map("membership_id")
  accessLevel  OperationAccessLevel @default(READ_ONLY) @map("access_level")
  modules      AccessModule[] // vide = selon le niveau
  grantedById  Int?                 @map("granted_by_id")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  operation  Operation  @relation(fields: [operationId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([operationId, membershipId])
  @@index([operationId])
  @@map("operation_accesses")
}
