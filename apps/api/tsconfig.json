{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strictPropertyInitialization": false,
    "declaration": false,
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": "./",
    // `multer` déclare `Express.Multer.File` en ambiant : sans l'inscrire ici,
    // la liste blanche des types le laisserait dehors et le dépôt de fichiers
    // de la GED ne compilerait pas.
    "types": ["node", "multer"]
  },
  "include": ["src/**/*.ts"]
}
